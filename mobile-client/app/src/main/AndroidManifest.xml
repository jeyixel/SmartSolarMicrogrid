<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Member 2: FINE gives GPS-level accuracy; COARSE is the ~1-3 km fallback
        the user may choose instead on Android 12+. Both are declared because
        the system permission dialog lets the user grant only the approximate
        one, and the app must still work in that case.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolarMicrogrid"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Member 1: authentication is the entry point of the app. -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:theme="@style/Theme.SmartSolarMicrogrid.AuthLight"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:theme="@style/Theme.SmartSolarMicrogrid.AuthLight"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.dashboard.ProsumerDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.GridOperatorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Member 2: microgrid node map. -->
        <activity
            android:name=".ui.map.NearbyStationsActivity"
            android:exported="false"
            android:label="@string/title_nearby_stations" />

        <!-- Member 4: booking history & telemetry & QR passes. -->
        <activity
            android:name=".ui.booking.BookingHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.booking.ReservationQrActivity"
            android:exported="false" />

        <!-- Member 3: reservation workflow & validation. -->
        <activity
            android:name=".ui.booking.CreateBookingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.booking.SlotPickerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.booking.MyReservationsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.booking.EditBookingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.booking.BookingSummaryActivity"
            android:exported="false" />

    </application>

</manifest>
