<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark Mode). -->
    <style name="Base.Theme.SmartSolarMicrogrid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#81C784</item>
        <item name="colorOnPrimary">#003300</item>
        <item name="colorPrimaryContainer">#1B5E20</item>
        <item name="colorOnPrimaryContainer">#E8F5E9</item>
        <item name="colorSecondary">#66BB6A</item>
        <item name="colorTertiary">#4DB6AC</item>
    </style>

    <!-- Auth screens remain Light in Dark Mode with light background, white cards, and dark readable text -->
    <style name="Theme.SmartSolarMicrogrid.AuthLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/solar_green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/solar_green_light</item>
        <item name="colorOnPrimaryContainer">@color/solar_green_dark</item>
        <item name="colorSecondary">@color/solar_green_secondary</item>
        <item name="colorTertiary">@color/solar_teal</item>
        <item name="android:colorBackground">@color/solar_bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/solar_bg_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.OutlinedBox</item>
    </style>
</resources>
