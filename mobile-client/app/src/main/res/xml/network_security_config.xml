<?xml version="1.0" encoding="utf-8"?>
<!--
    Android blocks plain HTTP by default since API 28. The development backend
    runs on http://localhost:5127 - reached from the emulator as 10.0.2.2, and
    from a physical device on the LAN by the machine's local IP - so cleartext
    is permitted for those development hosts ONLY. Everything else still
    requires HTTPS, and this whole exception must be removed before any real
    deployment.

    A user trust anchor is allowed for these hosts so that a debugging proxy
    (Charles, Fiddler) can be used against the dev backend; it does not apply
    to any other domain.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Member 1: local machine on the LAN, for testing on a real phone. -->
        <domain includeSubdomains="true">192.168.8.198</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
