<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/prosumerDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.dashboard.ProsumerDashboardActivity">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="@drawable/bg_avatar_circle"
            android:src="@drawable/ic_bolt"
            android:importantForAccessibility="no"
            app:tint="@color/color_on_brand_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="GridPulse"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNotifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notifications"
            android:contentDescription="Notifications"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Greeting Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/color_on_brand"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"
                    tools:text="HJ" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Good afternoon," />

                    <TextView
                        android:id="@+id/tvWelcomeUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Heshan" />

                    <TextView
                        android:id="@+id/tvUserRoleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Solar Prosumer"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Energy Overview Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_energy_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bolt"
                        android:importantForAccessibility="no"
                        app:tint="@color/color_on_brand_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Energy Overview"
                        android:textColor="@color/color_on_brand"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSyncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Syncing…"
                        android:textColor="@color/color_on_brand_accent"
                        android:textSize="11sp"
                        tools:text="● Updated 15:54" />
                </LinearLayout>

                <!-- Stats Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUpcomingApprovedCount"
                            style="@style/Widget.App.Dashboard.StatValue"
                            tools:text="2" />

                        <TextView
                            style="@style/Widget.App.Dashboard.StatLabel"
                            android:text="Upcoming" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPendingCount"
                            style="@style/Widget.App.Dashboard.StatValue"
                            tools:text="1" />

                        <TextView
                            style="@style/Widget.App.Dashboard.StatLabel"
                            android:text="Pending review" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalCount"
                            style="@style/Widget.App.Dashboard.StatValue"
                            tools:text="7" />

                        <TextView
                            style="@style/Widget.App.Dashboard.StatLabel"
                            android:text="All bookings" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Next Energy Transfer Sub-card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNextTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/color_brand_overlay"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/color_brand_stroke"
                    app:strokeColor="@color/color_brand_stroke"
                    app:strokeWidth="1dp">

                    <!-- Populated state: shown when an upcoming reservation exists -->
                    <LinearLayout
                        android:id="@+id/layoutNextTransferContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="NEXT ENERGY TRANSFER"
                                android:letterSpacing="0.06"
                                android:textColor="@color/color_on_brand_accent"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvNextStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_active"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textColor="@color/color_on_primary_container"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                tools:text="APPROVED" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNextStation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/color_on_brand"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="Tangalle Solar Hub" />

                        <TextView
                            android:id="@+id/tvNextSchedule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/color_on_brand_subtle"
                            android:textSize="13sp"
                            app:drawableStartCompat="@drawable/ic_schedule"
                            app:drawableTint="@color/color_on_brand_subtle"
                            tools:text="Tomorrow • 10:30 – 11:30" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvNextEnergy"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/color_on_brand_accent"
                                android:textSize="13sp"
                                tools:text="5.0 kWh • Charging" />

                            <TextView
                                android:id="@+id/tvNextAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"
                                android:text="Show QR"
                                android:textColor="@color/color_on_brand"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:drawableEndCompat="@drawable/ic_chevron_right"
                                app:drawableTint="@color/color_on_brand" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Empty state: shown when there are no upcoming reservations -->
                    <LinearLayout
                        android:id="@+id/layoutNextTransferEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNextEmptyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No upcoming transfers"
                                android:textColor="@color/color_on_brand"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvNextEmptySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Find a nearby station and reserve a slot."
                                android:textColor="@color/color_on_brand_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBookFromEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Book"
                            android:textColor="@color/color_brand"
                            app:backgroundTint="@color/color_on_brand"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_add_circle"
                            app:iconSize="18dp"
                            app:iconTint="@color/color_brand" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Quick Actions -->
            <TextView
                style="@style/Widget.App.Dashboard.SectionTitle"
                android:layout_marginTop="28dp"
                android:text="Quick Actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/btnQuickNearby"
                    style="@style/Widget.App.Dashboard.QuickAction"
                    android:contentDescription="Nearby stations">
                    <ImageView
                        style="@style/Widget.App.Dashboard.QuickActionIcon"
                        android:src="@drawable/ic_place" />
                    <TextView
                        style="@style/Widget.App.Dashboard.QuickActionLabel"
                        android:text="Stations" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnQuickBook"
                    style="@style/Widget.App.Dashboard.QuickAction"
                    android:contentDescription="Book energy">
                    <ImageView
                        style="@style/Widget.App.Dashboard.QuickActionIcon"
                        android:src="@drawable/ic_add_circle" />
                    <TextView
                        style="@style/Widget.App.Dashboard.QuickActionLabel"
                        android:text="Book" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnQuickBookings"
                    style="@style/Widget.App.Dashboard.QuickAction"
                    android:contentDescription="My bookings">
                    <ImageView
                        style="@style/Widget.App.Dashboard.QuickActionIcon"
                        android:src="@drawable/ic_event" />
                    <TextView
                        style="@style/Widget.App.Dashboard.QuickActionLabel"
                        android:text="Bookings" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnQuickQr"
                    style="@style/Widget.App.Dashboard.QuickAction"
                    android:contentDescription="My QR code">
                    <ImageView
                        style="@style/Widget.App.Dashboard.QuickActionIcon"
                        android:src="@drawable/ic_qr_code" />
                    <TextView
                        style="@style/Widget.App.Dashboard.QuickActionLabel"
                        android:text="My QR" />
                </LinearLayout>
            </LinearLayout>

            <!-- Nearby Solar Stations Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Widget.App.Dashboard.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Nearby Solar Stations" />

                <TextView
                    android:id="@+id/tvSeeMap"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="2dp"
                    android:text="See map"
                    android:textColor="@color/color_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/color_accent" />
            </LinearLayout>

            <!-- Map entry card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_map_placeholder"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:src="@drawable/ic_map_outline"
                        android:importantForAccessibility="no"
                        app:tint="@color/color_on_brand" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Explore stations near you"
                            android:textColor="@color/color_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="See live slot availability on the map"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        app:tint="@color/color_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nearest station preview (populated by the map feature when available) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreviewStation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_outline"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="9dp"
                        android:background="@drawable/bg_action_tile"
                        android:src="@drawable/ic_place"
                        android:importantForAccessibility="no"
                        app:tint="@color/color_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvPreviewStationName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Tangalle Solar Hub" />

                            <TextView
                                android:id="@+id/tvPreviewStationStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_pill_active"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:textColor="@color/color_on_primary_container"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                tools:text="● Active" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPreviewStationDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="2.4 km away  •  4 slots available" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:elevation="16dp"
        app:itemIconTint="@color/color_primary"
        app:itemTextColor="@color/color_primary"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:menu="@menu/bottom_nav_prosumer"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
