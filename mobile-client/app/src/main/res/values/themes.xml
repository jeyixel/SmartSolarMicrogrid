<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartSolarMicrogrid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Solar Green Color Palette -->
        <item name="colorPrimary">@color/solar_green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/solar_green_light</item>
        <item name="colorOnPrimaryContainer">@color/solar_green_dark</item>
        <item name="colorSecondary">@color/solar_green_secondary</item>
        <item name="colorTertiary">@color/solar_teal</item>
        <item name="android:colorBackground">@color/solar_bg_light</item>
    </style>

    <style name="Theme.SmartSolarMicrogrid" parent="Base.Theme.SmartSolarMicrogrid" />

    <!-- Dedicated Light Theme for Auth Screens (Login & Register) ensuring light appearance in both Light and Dark Mode -->
    <style name="Theme.SmartSolarMicrogrid.AuthLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/solar_green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/solar_green_light</item>
        <item name="colorOnPrimaryContainer">@color/solar_green_dark</item>
        <item name="colorSecondary">@color/solar_green_secondary</item>
        <item name="colorTertiary">@color/solar_teal</item>
        <item name="android:colorBackground">@color/solar_bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/solar_bg_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Widget.App.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_box_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/solar_green_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="errorTextColor">@color/error_red</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
