<?xml version="1.0" encoding="utf-8"?>
<!--
    Semantic color roles - LIGHT theme.

    values-night/colors.xml redefines every role below for dark mode, so
    layouts, drawables, styles and code only ever reference these names and
    never a raw hex value or a palette_* color.
-->
<resources>
    <!-- Screen & containers -->
    <color name="color_background">@color/palette_neutral_50</color>
    <color name="color_surface">@color/palette_white</color>
    <color name="color_surface_variant">@color/palette_neutral_50</color>
    <color name="color_outline">@color/palette_neutral_200</color>

    <!-- Text -->
    <color name="text_primary">@color/palette_neutral_900</color>
    <color name="text_secondary">@color/palette_neutral_600</color>

    <!-- Primary: buttons, links, icons and accents on surfaces -->
    <color name="color_primary">@color/palette_green_900</color>
    <color name="color_on_primary">@color/palette_white</color>
    <color name="color_primary_container">@color/palette_green_100</color>
    <color name="color_on_primary_container">@color/palette_green_700</color>

    <!-- Brand: hero cards and avatars that stay deep green in both themes -->
    <color name="color_brand">@color/palette_green_900</color>
    <color name="color_brand_variant">@color/palette_green_800</color>
    <color name="color_on_brand">@color/palette_white</color>
    <color name="color_on_brand_subtle">@color/palette_white_80</color>
    <color name="color_on_brand_muted">@color/palette_white_70</color>
    <color name="color_on_brand_accent">@color/palette_green_200</color>
    <color name="color_on_brand_warning">@color/palette_amber_100</color>
    <color name="color_brand_stroke">@color/palette_white_20</color>
    <color name="color_brand_pill">@color/palette_white_15</color>
    <color name="color_brand_overlay">@color/palette_white_12</color>

    <!-- Secondary accent (map, distance, links) -->
    <color name="color_accent">@color/palette_teal_700</color>
    <color name="color_map_card_start">@color/palette_teal_100</color>
    <color name="color_map_card_end">@color/palette_teal_200</color>

    <!-- Status -->
    <color name="color_warning">@color/palette_amber_800</color>
    <color name="color_warning_container">@color/palette_amber_100</color>
    <color name="color_on_warning_container">@color/palette_amber_800</color>
    <color name="color_error">@color/palette_red_800</color>
    <color name="color_on_error">@color/palette_white</color>
    <color name="color_error_container">@color/palette_red_50</color>
    <color name="color_error_outline">@color/palette_red_100</color>

    <!-- Legacy / Compatibility Colors from backup/energy-booking-backup -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="solar_green_primary">#0B3B24</color>
    <color name="solar_green_secondary">#144D34</color>
    <color name="solar_green_light">#A5D6A7</color>
    <color name="solar_green_dark">#003300</color>
    <color name="solar_teal">#00796B</color>
    <color name="solar_amber">#F57F17</color>
    <color name="solar_bg_light">#F7F9F7</color>
    <color name="card_border">#E0E5E0</color>
    <color name="pill_active_bg">#C8E6C9</color>
    <color name="pill_active_text">#2E7D32</color>
    <color name="pill_review_bg">#FFECB3</color>
    <color name="pill_review_text">#F57F17</color>
    <color name="map_placeholder_bg">#B2DFDB</color>
    <color name="error_red">#C62828</color>
    <color name="logout_bg">#FFEBEE</color>
    <color name="logout_border">#FFCDD2</color>
</resources>
