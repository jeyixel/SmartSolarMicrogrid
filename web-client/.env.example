# Copy to .env.local and adjust if your backend runs elsewhere.
#
# The station API's base URL. Must match the backend's launch profile: the
# default http profile in backend-service/Properties/launchSettings.json listens
# on http://localhost:5127.
#
# Whatever origin you use here must also appear in the backend's
# Cors:AllowedOrigins setting once that list is non-empty.
VITE_API_BASE_URL=http://localhost:5127
