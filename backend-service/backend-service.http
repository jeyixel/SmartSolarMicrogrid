@host = http://localhost:5127

# Identity for local testing. The development header handler reads these two
# headers and builds a principal from them; once Member 1's authentication is
# registered, replace them with `Authorization: Bearer {{token}}`.
@backoffice = X-Debug-Role: Backoffice
@operator = X-Debug-Role: GridOperator
@prosumer = X-Debug-Role: Prosumer

# Paste an id returned by "Create station" here to run the single-station calls.
@stationId = REPLACE_WITH_A_REAL_ID


### Create station (Backoffice) → 201
POST {{host}}/api/stations
Content-Type: application/json
{{backoffice}}
X-Debug-UserId: backoffice-001

{
  "stationCode": "CMB-NORTH-01",
  "name": "Colombo North Solar Hub",
  "description": "Rooftop array, Block B",
  "addressLine": "45 Galle Road, Colombo 03",
  "latitude": 6.927079,
  "longitude": 79.861244,
  "capacityKWh": 250.5,
  "totalBatterySlots": 20,
  "availableBatterySlots": 7,
  "contactPhone": "+94112345678",
  "operationalSchedule": [
    { "dayOfWeek": "Monday",    "openTime": "06:00", "closeTime": "20:00" },
    { "dayOfWeek": "Tuesday",   "openTime": "06:00", "closeTime": "20:00" },
    { "dayOfWeek": "Wednesday", "openTime": "06:00", "closeTime": "20:00" },
    { "dayOfWeek": "Thursday",  "openTime": "06:00", "closeTime": "20:00" },
    { "dayOfWeek": "Friday",    "openTime": "06:00", "closeTime": "20:00" },
    { "dayOfWeek": "Saturday",  "openTime": "08:00", "closeTime": "17:00" },
    { "dayOfWeek": "Sunday",    "openTime": "00:00", "closeTime": "00:01", "isClosed": true }
  ]
}


