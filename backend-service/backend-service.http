PUT {{host}}/api/stations/{{stationId}}
Content-Type: application/json
{{operator}}

{
  "name": "Colombo North Solar Hub (Renamed)",
  "latitude": 6.927079,
  "longitude": 79.861244,
  "capacityKWh": 999,
  "totalBatterySlots": 24,
  "availableBatterySlots": 3
}


